#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "dd_version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "dd-gui.manifest"

IDI_APP ICON "dd.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DD_VERSION_MAJOR, DD_VERSION_MINOR, DD_VERSION_PATCH, 0
 PRODUCTVERSION DD_VERSION_MAJOR, DD_VERSION_MINOR, DD_VERSION_PATCH, 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", DD_PRODUCT_NAME
            VALUE "FileVersion", DD_VERSION_STR
            VALUE "InternalName", "dd-gui"
            VALUE "LegalCopyright", DD_COPYRIGHT
            VALUE "OriginalFilename", "dd-gui.exe"
            VALUE "ProductName", DD_PRODUCT_NAME
            VALUE "ProductVersion", DD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 520, 393
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_ACCEPTFILES | WS_EX_APPWINDOW
CAPTION DD_PRODUCT_NAME
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Input:", -1, 7, 9, 40, 8
    COMBOBOX        IDC_INPUT, 52, 7, 84, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_DISK, 141, 7, 315, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_SRCFILE, 141, 7, 315, 13, ES_AUTOHSCROLL | NOT WS_VISIBLE
    LTEXT           "", IDC_SRCNOTE, 141, 9, 315, 8, NOT WS_VISIBLE
    PUSHBUTTON      "Bro&wse...", IDC_BROWSE_SRC, 463, 6, 50, 14, NOT WS_VISIBLE | WS_TABSTOP

    LTEXT           "&Output:", -1, 7, 27, 40, 8
    COMBOBOX        IDC_OUTPUT, 52, 25, 84, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_DISK2, 141, 25, 315, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    EDITTEXT        IDC_FILE, 141, 25, 315, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_DSTNOTE, 141, 27, 315, 8, NOT WS_VISIBLE
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 463, 24, 50, 14

    AUTOCHECKBOX    "&Show fixed disks (internal drives)", IDC_SHOWFIXED, 141, 42, 220, 10
    PUSHBUTTON      "Refres&h", IDC_REFRESH, 463, 41, 50, 14

    LTEXT           "", IDC_LAYOUT, 7, 58, 506, 34
    CONTROL         "", IDC_PARTS, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
                    7, 94, 506, 52
    GROUPBOX        "Reading", -1, 7, 149, 250, 66
    AUTOCHECKBOX    "&Raw: all of it, not just its partitions", IDC_FIT, 15, 161, 238, 10
    AUTOCHECKBOX    "Only &used space; free space as zeros", IDC_SPARSE, 15, 174, 238, 10
    AUTOCHECKBOX    "Allow u&nclean file systems", IDC_UNCLEAN, 26, 187, 227, 10
    AUTOCHECKBOX    "Lock the source's &volumes", IDC_LOCKIN, 15, 200, 238, 10

    GROUPBOX        "Writing", -1, 263, 149, 250, 66
    AUTOCHECKBOX    "&Force dismount if in use", IDC_FORCE, 271, 161, 238, 10
    AUTOCHECKBOX    "Write a hash fil&e", IDC_HASHES, 271, 174, 238, 10
    AUTOCHECKBOX    "Verif&y what is written", IDC_VERIFY, 271, 187, 238, 10

    LTEXT           "Co&mpression:", -1, 7, 223, 44, 8
    COMBOBOX        IDC_XZ, 52, 221, 200, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bloc&k size:", -1, 263, 223, 40, 8
    COMBOBOX        IDC_BS, 305, 221, 60, 100, CBS_DROPDOWNLIST | WS_TABSTOP

    CONTROL         "", IDC_PROGRESS, PROGRESS_CLASS, 0, 7, 241, 506, 11
    LTEXT           "", IDC_STATUS, 7, 256, 506, 8, SS_ENDELLIPSIS
    LTEXT           "", IDC_ETA, 7, 266, 506, 8
    EDITTEXT        IDC_LOG, 7, 278, 506, 88, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "Command &line", IDC_CMDLINE, 7, 373, 70, 14
    PUSHBUTTON      "Make s&parse map", IDC_MAKEMAP, 82, 373, 75, 14
    DEFPUSHBUTTON   "&Start", IDC_START, 353, 373, 50, 14
    PUSHBUTTON      "S&top", IDC_STOP, 408, 373, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 463, 373, 50, 14
END