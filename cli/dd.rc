#include <windows.h>
#include "dd_version.h"

1 ICON "..\\gui\\dd.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DD_VERSION_MAJOR, DD_VERSION_MINOR, DD_VERSION_PATCH, 0
 PRODUCTVERSION DD_VERSION_MAJOR, DD_VERSION_MINOR, DD_VERSION_PATCH, 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", DD_PRODUCT_NAME " (command line)"
            VALUE "FileVersion", DD_VERSION_STR
            VALUE "InternalName", "dd"
            VALUE "LegalCopyright", DD_COPYRIGHT
            VALUE "OriginalFilename", "dd.exe"
            VALUE "ProductName", DD_PRODUCT_NAME
            VALUE "ProductVersion", DD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
